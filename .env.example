# Backend API base URL.
# In local dev, keep "/api": Vite proxies /api, /broadcasting/auth, /app and /storage
# to the Laravel backend (localhost:8000) and Reverb (localhost:8080), see vite.config.js.
# In production, set this to your backend URL (e.g. https://api.example.com/api)
# or configure a reverse proxy/rewrite for /api.
VITE_API_BASE_URL=/api

# Public URL of this frontend (used for QR login / remote scan links)
VITE_PUBLIC_URL=http://localhost:5173

# Laravel Reverb public app key (must match REVERB_APP_KEY on the backend).
# This is a PUBLIC key. Never put REVERB_APP_SECRET here.
VITE_REVERB_APP_KEY=your_reverb_app_key
