# Backend API base URL (Laravel LMSAPI)
VITE_API_BASE_URL=http://localhost:8000/api

# Public URL of this frontend (used for QR login / remote scan links)
VITE_PUBLIC_URL=http://localhost:5173

# Laravel Reverb public app key (must match REVERB_APP_KEY on the backend).
# This is a PUBLIC key. Never put REVERB_APP_SECRET here.
VITE_REVERB_APP_KEY=your_reverb_app_key
